<Window x:Class="MusicPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MusicPlayer"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="MainWindow" Height="750" Width="1200" ResizeMode="NoResize" 
        AllowsTransparency="True" WindowStartupLocation="CenterScreen" WindowStyle="None" Background="Transparent" Loaded="Window_Loaded">
    <Border Background="#170f23" CornerRadius="40" MouseDown="Border_MouseDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Menu -->
            <Border Grid.RowSpan="4" Background="#231B2E" CornerRadius="40,0,0,40">
                <StackPanel Margin="0 30 0 0 ">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="63,2,0,10">
                        <Ellipse Fill="#ff6258" Width="10" Height="10"/>
                        <Ellipse Fill="#ffbf2f" Width="10" Height="10" Margin="7 0"/>
                        <Ellipse Fill="#2acb42" Width="10" Height="10"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,18,0,2" Width="220">
                        <Ellipse Fill="#ff6258" Width="70" Height="70" Margin="55 0 0 0"/>
                        <TextBlock Text="MP3" Foreground="White" FontSize="30" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,-44"/>
                    </StackPanel>
                    <TextBlock Text="MusicPlayer" Foreground="White" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="-15,-65,0,0"/>
                    <Button Style="{StaticResource menuButton}" Foreground="White" Margin="0,33,0,3">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Home" Foreground="White" Width="25" Height="25" />
                            <TextBlock Text="Home" Margin="10,0,60,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource menuButton}" Foreground="White" Margin="0,3,0,3">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Music" Foreground="White" Width="25" Height="25" />
                            <TextBlock Text="Library" Margin="10,0,55,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource menuButton}" Foreground="White" Margin="0,3,0,3">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="MicNone" Foreground="White" Width="25" Height="25" />
                            <TextBlock Text="Karaoke" Margin="10,0,10,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource menuButton}" Foreground="White" Margin="0,3,0,3">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Upload" Foreground="White" Width="25" Height="25" />
                            <TextBlock Text="Upload Music" Margin="10,0,10,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource menuButton}" Foreground="White" Margin="0,3,0,3">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="PenAdd" Foreground="White" Width="25" Height="25" />
                            <TextBlock Text="Create Playlist" Margin="10,0,10,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <StackPanel Orientation="Horizontal" Margin="15,150,0,38" Height="39" >
                        <UniformGrid Columns="2">
                            <Icon:PackIconMaterial Kind="Twitter" Foreground="White" Width="35" Height="35" Margin="3,0,0,0"/>
                        </UniformGrid>
                        <UniformGrid Columns="2">
                            <Icon:PackIconMaterial Kind="Instagram" Foreground="White" Width="35" Height="35" Margin="4,0,0,0" />
                        </UniformGrid>
                        <UniformGrid Columns="2">
                            <Icon:PackIconMaterial Kind="Facebook" Foreground="White" Width="35" Height="35" Margin="3,0,0,0" />
                        </UniformGrid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Title -->
            <TextBlock Grid.Column="1" Text="TRENDING SONGS" Foreground="White" FontSize="28" FontWeight="Bold" Margin="20,20,0,10" TextAlignment="Center"/>

            <!-- Search Bar -->
            <DockPanel Grid.Column="1" Grid.Row="1" Width="300" Height="30" Margin="20,0,0,10" VerticalAlignment="Top" HorizontalAlignment="Left" Background="#2F2739" LastChildFill="True">
                <materialDesign:PackIcon Kind="Magnify" Foreground="Gray" Width="20" Height="20" VerticalAlignment="Center" Margin="5,0"/>
                <TextBox x:Name="searchTextBox" Width="220" Height="30" VerticalAlignment="Center" BorderThickness="0" Background="Transparent" Foreground="White" Padding="5,0" KeyDown="searchTextBox_KeyDown"/>
                <Button Content="Search" Click="SearchButton_Click" Width="60" Height="30" Background="#ff6258" Foreground="White" VerticalAlignment="Center" Margin="5,0,0,0"/>
            </DockPanel>

            <!-- ListView for Songs -->
            <ListView x:Name="songListView" Grid.Column="1" Grid.Row="2" Background="#231B2E" BorderBrush="Transparent" SelectionChanged="SongListView_SelectionChanged">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="5" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#2F2739" CornerRadius="8" Padding="10" Width="180" Height="235">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <!-- Row for the image -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Row for the song info -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Row for the duration -->
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Image -->
                                <Image Source="{Binding ImageUrl}" Grid.Row="0" Grid.Column="0" Height="145" Width="Auto"  Stretch="UniformToFill" VerticalAlignment="Top" Margin="0,0,0,10"/>

                                <!-- Song Info -->
                                <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Width="Auto">
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding Artist}" FontSize="14" Foreground="LightGray"/>
                                </StackPanel>

                                <!-- Duration -->
                                <TextBlock Text="{Binding Duration}" FontSize="12" Foreground="Gray" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Music Player Bar -->
            <Border Grid.Column="1" Grid.Row="3" Background="#231B2E" Height="60" VerticalAlignment="Bottom" CornerRadius="0 0 40 0">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource controlButton}" Click="SkipPreviousButton_Click">
                            <materialDesign:PackIcon Kind="SkipPrevious" Foreground="White" Width="25" Height="25"/>
                        </Button>
                        <Button Style="{StaticResource controlButton}" Click="PlayPauseButton_Click">
                            <materialDesign:PackIcon x:Name="PlayPauseIcon" Kind="Play" Foreground="White" Width="25" Height="25"/>
                        </Button>
                        <Button Style="{StaticResource controlButton}" Click="SkipNextButton_Click">
                            <materialDesign:PackIcon Kind="SkipNext" Foreground="White" Width="25" Height="25"/>
                        </Button>
                    </StackPanel>
                    <!-- Time Slider and Display -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Now Playing Info -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                            <Image x:Name="nowPlayingImage" Width="50" Height="50" Stretch="UniformToFill" Margin="0,0,10,0" />
                            <TextBlock x:Name="nowPlayingTitle" Foreground="White" FontSize="16" VerticalAlignment="Center" />
                        </StackPanel>
                        <!-- Slider and Time Display -->
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                            <Slider x:Name="timeSlider" Width="400" Margin="10,0" Maximum="100" ValueChanged="TimeSlider_ValueChanged"/>
                            <TextBlock x:Name="timeDisplay" Text="00:00 / 00:00" Foreground="White" VerticalAlignment="Center" Margin="10,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            <MediaElement x:Name="mediaElement" LoadedBehavior="Manual" UnloadedBehavior="Manual" />
        </Grid>
    </Border>
</Window>
